1. arguments.py: add a hasattr guard in the colocate branch. Legacy
   sglang 0.5.13's ServerArgs has no cuda_graph_backend_prefill field, so
   miles_validate_args raises AttributeError on direct access;
   _compute_server_args already strips unknown sglang_* keys, so skipping
   the assignment does not change runtime behavior.

2. placement_group.py: ray.get_gpu_ids() returns numeric ids as strings,
   so sorted() orders them lexicographically ("10" < "8"). Compare
   numeric ids as ints so that e.g. "10" does not sort before "8".
---
 miles/ray/placement_group.py |  4 ++++
 miles/utils/arguments.py     | 25 ++++++++++++++-----------
 2 files changed, 18 insertions(+), 11 deletions(-)

diff --git a/miles/ray/placement_group.py b/miles/ray/placement_group.py
index f125a65..076a4ab 100644
--- a/miles/ray/placement_group.py
+++ b/miles/ray/placement_group.py
@@ -45,6 +45,10 @@ def sort_key(x):
             # representation that allows for sorting.
             node_ip_parts = [ord(c) for c in node_identifier]
 
+    # ray.get_gpu_ids() returns numeric ids as strings ("8", "10") or GPU UUIDs;
+    # compare numeric ids as ints so that e.g. "10" does not sort before "8".
+    if isinstance(gpu_id, str) and gpu_id.isdigit():
+        gpu_id = int(gpu_id)
     return (node_ip_parts, gpu_id)
 
 
diff --git a/miles/utils/arguments.py b/miles/utils/arguments.py
index c0eba55..5303b41 100644
--- a/miles/utils/arguments.py
+++ b/miles/utils/arguments.py
@@ -3298,17 +3298,20 @@ def miles_validate_args(args):
             args.offload_train = True
         if args.offload_rollout is None:
             args.offload_rollout = True
-        if args.sglang_cuda_graph_backend_prefill is None:
-            args.sglang_cuda_graph_backend_prefill = "disabled"
-            logger.info(
-                "Colocate mode: defaulting --sglang-cuda-graph-backend-prefill=disabled to avoid NVLS OOM. "
-                "Set --sglang-cuda-graph-backend-prefill explicitly to override."
-            )
-        elif args.sglang_cuda_graph_backend_prefill != "disabled":
-            logger.warning(
-                f"Warning: colocate mode with --sglang-cuda-graph-backend-prefill="
-                f"{args.sglang_cuda_graph_backend_prefill} may trigger NVLS OOM."
-            )
+        # Older sglang builds lack ServerArgs.cuda_graph_backend_prefill; _compute_server_args
+        # drops unknown sglang_* keys anyway, so only default/warn when the flag exists.
+        if hasattr(args, "sglang_cuda_graph_backend_prefill"):
+            if args.sglang_cuda_graph_backend_prefill is None:
+                args.sglang_cuda_graph_backend_prefill = "disabled"
+                logger.info(
+                    "Colocate mode: defaulting --sglang-cuda-graph-backend-prefill=disabled to avoid NVLS OOM. "
+                    "Set --sglang-cuda-graph-backend-prefill explicitly to override."
+                )
+            elif args.sglang_cuda_graph_backend_prefill != "disabled":
+                logger.warning(
+                    f"Warning: colocate mode with --sglang-cuda-graph-backend-prefill="
+                    f"{args.sglang_cuda_graph_backend_prefill} may trigger NVLS OOM."
+                )
         if args.rollout_num_gpus != args.actor_num_gpus_per_node * args.actor_num_nodes:
             logger.info(
                 f"rollout_num_gpus {args.rollout_num_gpus} != actor_num_gpus_per_node {args.actor_num_gpus_per_node} "
