# Copyright © 2026 Zhejiang Runhe Cloud Intelligence Technology Co., Ltd

# Miles-for-SAIL v0.1.0 PPU Docker Image
# Build context = repo root; sglang patches live in docker/ppu_patch_sglang_0.5.13/,
# and the miles-0001 patch must be supplied at
# miles_0.1.0_sglang_0.5.13_patches/ in the build context:
#   docker build -t miles-sail:v0.1.0 \
#     -f docker/Dockerfile.ppu \
#     --build-arg http_proxy=$http_proxy --build-arg https_proxy=$https_proxy .

FROM pkg.flytiger-eco.com/docker_release/llm:sdk2.2.0-pytorch2.11.0-ubuntu24.04-cuda13.0-rlbase0.5.13-py312-20261008

ARG http_proxy
ARG https_proxy
ARG no_proxy

ARG MEGATRON_COMMIT=37f91617b95c1ef4f01fc66210e502572ad97fda
ARG MILES_TAG=v0.1.0

WORKDIR /root/

# =====================================================================
# Step 1: Environment configuration
# =====================================================================

# Proxy does SSL interception; skip verification globally
RUN git config --global http.sslVerify false && \
    git config --global http.postBuffer 524288000 && \
    git config --global http.version HTTP/1.1 && \
    pip config set global.trusted-host "pkg.flytiger-eco.com files.pythonhosted.org pypi.org"

# wgetrc: skip SSL verification (apex setup.py uses wget internally)
RUN echo 'check_certificate = off' > /etc/wgetrc && \
    echo 'check_certificate = off' >> /root/.wgetrc

# curl: skip SSL verification (proxy does SSL interception, e.g. github release downloads).
# Upstream curl only reads $CURL_HOME/.curlrc or $HOME/.curlrc - /etc/curlrc is a
# distro patch (absent here); BuildKit RUN leaves HOME unset, so pin CURL_HOME.
RUN mkdir -p /etc/curl && echo 'insecure' > /etc/curl/.curlrc && \
    rm -f /etc/curlrc
ENV CURL_HOME=/etc/curl

# =====================================================================
# Step 2: Install dependencies
# =====================================================================

# Ray upgrade
RUN pip uninstall -y ray && \
    pip install "ray[default]==2.58" -i https://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com

# apex
RUN SAIL_SDK_MATCH_STRATEGY=off pip install "apex==24.4.1+v0.1.0.ppu2.2.0" \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com

# transformer_engine
RUN pip install "transformer_engine==2.16+v0.1.0.ppu2.2.0" \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com

# Megatron-LM
RUN pip uninstall -y megatron-core || true

RUN git clone --depth 1 https://github.com/radixark/Megatron-LM.git /root/Megatron-LM && \
    cd /root/Megatron-LM && \
    git fetch --depth 1 origin ${MEGATRON_COMMIT} && \
    git checkout -q FETCH_HEAD && \
    pip install -e . --no-deps \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com

# Megatron-Bridge
RUN git clone --depth 1 https://github.com/radixark/Megatron-Bridge.git /tmp/megatron-bridge && \
    cd /tmp/megatron-bridge && \
    git fetch --depth 1 origin 7f0fb3456f8ffe47599b5fd167b454605d85f932 && \
    git checkout -q FETCH_HEAD && \
    pip install . --no-deps --no-build-isolation

# mbridge
RUN git clone --depth 1 https://github.com/ISEEKYAN/mbridge.git /tmp/mbridge && \
    cd /tmp/mbridge && \
    git fetch --depth 1 origin 89eb10887887bc74853f89a4de258c0702932a1c && \
    git checkout -q FETCH_HEAD && \
    sed -i 's/^license = "\(.*\)"$/license = {text = "\1"}/' pyproject.toml && \
    sed -i '/^license-files = /d' pyproject.toml && \
    pip install . --no-deps

# sgl-router
RUN curl -kfSL -o /tmp/sglang_router-0.3.2-cp38-abi3-manylinux_2_39_x86_64.whl \
      "https://github.com/yueming-yuan/miles-wheels/releases/download/cu130-x86_64/sglang_router-0.3.2-cp38-abi3-manylinux_2_39_x86_64.whl" && \
    pip install --force-reinstall --no-deps /tmp/sglang_router-0.3.2-cp38-abi3-manylinux_2_39_x86_64.whl && \
    rm -f /tmp/sglang_router-0.3.2-cp38-abi3-manylinux_2_39_x86_64.whl

# torch_memory_saver
RUN git clone --depth 1 https://github.com/fzyzcjy/torch_memory_saver.git /tmp/torch_memory_saver && \
    cd /tmp/torch_memory_saver && \
    git fetch --depth 1 origin f05a8754daf68238d54e4cf31cb3ba866684bbaf && \
    git checkout -q FETCH_HEAD && \
    TMS_CUDA_MAJOR="${TMS_CUDA_MAJOR:-$(python3 -c 'import torch; print(torch.version.cuda.split(".")[0])')}" && \
    export TMS_CUDA_MAJOR && \
    pip install . --no-cache-dir --force-reinstall

RUN SP=/usr/local/lib/python3.12/site-packages && \
    if [ -f "$SP/torch_memory_saver_hook_mode_preload_cu13.abi3.so" ] && \
       [ ! -f "$SP/torch_memory_saver_hook_mode_preload_cu12.abi3.so" ]; then \
        ln -sf torch_memory_saver_hook_mode_preload_cu13.abi3.so \
               "$SP/torch_memory_saver_hook_mode_preload_cu12.abi3.so"; \
    fi

# =====================================================================
# Step 3: Install miles（radixark tag v0.1.0）
# =====================================================================

RUN git clone --depth 1 --branch ${MILES_TAG} https://github.com/radixark/miles.git /root/miles && \
    test "$(git -C /root/miles rev-parse HEAD)" = 78527b9102b3a5f15891128cbec3ac6c2dc4089e

# miles patches
COPY miles_0.1.0_sglang_0.5.13_patches/miles-0001-sglang-0513-compat-and-gpu-id-sortkey.patch \
     /tmp/miles-patches/

RUN cd /root/miles && \
    git apply /tmp/miles-patches/miles-0001-sglang-0513-compat-and-gpu-id-sortkey.patch && \
    rm -rf /tmp/miles-patches

RUN grep -v ring_flash_attn /root/miles/requirements.txt > /tmp/requirements.txt && \
    pip install -r /tmp/requirements.txt \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com && \
    rm -f /tmp/requirements.txt

RUN pip install -e /root/miles --no-deps \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com

ENV PYTHONPATH=/root/miles:/root/Megatron-LM

RUN cd /root/miles/miles/backends/megatron_utils/kernels/int4_qat && \
    pip install . --no-build-isolation

# =====================================================================
# sglang patch
# =====================================================================

COPY docker/ppu_patch_sglang_0.5.13/sglang-0001-parallelism-context-parameter-mapper.patch \
     docker/ppu_patch_sglang_0.5.13/sglang-0002-begin-end-weight-update-session-api.patch \
     /tmp/sglang-patches/

RUN SP=/usr/local/lib/python3.12/site-packages/sglang && \
    cd "$SP" && \
    git init -q && \
    printf '__pycache__/\n*.pyc\n' > .gitignore && \
    git add -A && \
    git -c user.email=patch@local -c user.name=patch commit -qm \
        "baseline: original sglang 0.5.13" && \
    git apply -p2 /tmp/sglang-patches/sglang-0001-parallelism-context-parameter-mapper.patch && \
    git apply -p2 /tmp/sglang-patches/sglang-0002-begin-end-weight-update-session-api.patch && \
    git add -A && \
    git -c user.email=patch@local -c user.name=patch commit -qm \
        "miles patches: ParallelismContext/ParameterMapper + begin/end_weight_update session API + spec worker iter_runners" && \
    rm -rf /tmp/sglang-patches

# =====================================================================
# PPU compatibility patches 
# =====================================================================

# Patch 1: install standard flash-linear-attention + pla (PPU GDN kernels)
# Replaces the legacy sail_fla forwarder (cp PPU fla -> sail_fla + lazy __getattr__ shim):
# the independent pla package provides the PPU kernels, and sglang imports are
# repointed to pla.decode in Patch 1b below.
RUN pip uninstall -y fla && \
    pip install --no-deps "flash-linear-attention==0.4.2" "fla-core==0.4.2" -i https://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com && \
    pip install "pla==1.0.0+v0.1.0.ppu2.2.0" \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com && \
    python -c "import importlib.metadata as m; assert m.version('fla-core') == m.version('flash-linear-attention')" && \
    python -c "import fla.ops.gated_delta_rule; from fla.modules import FusedRMSNormGated, ShortConvolution" && \
    python -c "from pla.decode import fused_sigmoid_gating_delta_rule_forward_k_last, fused_sigmoid_gating_delta_rule_forward_k_last_packed"

# Patch 1b: sglang fla -> pla.decode import patch
RUN F1=/usr/local/lib/python3.12/site-packages/sglang/srt/layers/attention/fla/fused_sigmoid_gating_recurrent.py && \
    F2=/usr/local/lib/python3.12/site-packages/sglang/srt/layers/attention/fla/fused_recurrent.py && \
    sed -i 's/from fla import fused_sigmoid_gating_delta_rule_forward_k_last$/from pla.decode import fused_sigmoid_gating_delta_rule_forward_k_last/' "$F1" && \
    sed -i 's/from fla import ($/from pla.decode import (/' "$F2" && \
    grep -q 'from pla\.decode import fused_sigmoid_gating_delta_rule_forward_k_last$' "$F1" && \
    grep -q 'from pla\.decode import ($' "$F2" && \
    ! grep -rn 'from fla import' /usr/local/lib/python3.12/site-packages/sglang/srt/layers/attention/fla/*.py && \
    python3 -c "from pla.decode import fused_sigmoid_gating_delta_rule_forward_k_last, fused_sigmoid_gating_delta_rule_forward_k_last_packed; print('sglang fla->pla.decode patch OK')"

# Patch 2: update_weight_from_tensor.py - add per-chunk gloo barrier before ipc_collect
RUN F=miles/miles/backends/megatron_utils/update_weight/update_weight_from_tensor.py && \
    perl -i -0pe 's/^(\x20{16})(del long_lived_tensors(?:, mm_tower_tensors)?\n)(?!\x20{16}dist\.barrier)/$1$2$1dist.barrier(group=get_gloo_group())\n/gm; s/^(\x20{12})(del accumulated_named_tensors\n)(?!\x20{12}dist\.barrier)/$1$2$1dist.barrier(group=get_gloo_group())\n/gm' "$F" && \
    grep -A1 -E '^ {16}del long_lived_tensors$' "$F" | grep -q 'dist\.barrier' && \
    grep -A1 -E '^ {16}del long_lived_tensors, mm_tower_tensors$' "$F" | grep -q 'dist\.barrier' && \
    grep -A1 -E '^ {12}del accumulated_named_tensors$' "$F" | grep -q 'dist\.barrier'
# =====================================================================
# mooncake
# =====================================================================

# skip apt TLS verification - apt source is only reachable via the
# MITM proxy (GPG signatures still verified)
RUN printf 'Acquire::https::Verify-Peer "false";\nAcquire::https::Verify-Host "false";\n' \
        > /etc/apt/apt.conf.d/99skip-tls-verify && \
    apt-get update && \
    apt-get install -y --no-install-recommends libyaml-cpp0.8 && \
    rm -rf /var/lib/apt/lists/*

ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/mooncake:${LD_LIBRARY_PATH:-}

ENV HF_HUB_DISABLE_XET=1

# mooncake 0.3.12.post1
RUN SP=/usr/local/lib/python3.12/site-packages && \
    SAIL_SDK_MATCH_STRATEGY=off pip install --no-deps --no-cache-dir "mooncake==0.3.12.post1+v0.1.0.ppu2.2.0" msgpack \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com && \
    ! grep -q "group_ids" $SP/mooncake/structured_object_store.py && \
    python3 -c "from mooncake.structured_object_store import FieldSchema, MooncakeBundleTransfer, export_ref, import_ref; MooncakeBundleTransfer.put; MooncakeBundleTransfer.get; MooncakeBundleTransfer.release_result; MooncakeBundleTransfer.cleanup_dataproto" && \
    ! ldd $SP/mooncake/mooncake_master | grep -q "not found"

RUN F=miles/miles/utils/external_utils/command_utils.py && \
    grep -q 'default_kv_lease_ttl' $F || { \
        sed -i '/setsid mooncake_master --rpc_port/a\        f"--default_kv_lease_ttl=3600000 "' $F; \
    } && \
    grep -q 'default_kv_lease_ttl=3600000' $F && \
    python3 -c "import ast; ast.parse(open('miles/miles/utils/external_utils/command_utils.py').read()); print('command_utils.py lease-ttl patch OK')"

# modelopt (pulp pinned to 2.9.0: 4.0.0 hard-depends on orloge, breaking --no-deps)
RUN pip install --no-deps --no-cache-dir "nvidia-modelopt==0.37.0" "pulp==2.9.0" torchprofile \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com && \
    python3 -c "from modelopt.torch.quantization.utils import is_quantized; print('modelopt OK')"

RUN pip install --no-deps --no-cache-dir "huggingface_hub==1.29.0" \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com && \
    python3 -c "import huggingface_hub as h; assert h.__version__ == '1.29.0'; print('huggingface_hub OK')"

# flash-attn-3
RUN pip uninstall -y flash-attn-4 && \
    SAIL_SDK_MATCH_STRATEGY=off pip install --force-reinstall --no-deps --no-cache-dir "flash-attn-3==2.8.2+v0.2.0.ppu2.2.0" \
        --index-url https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        --trusted-host pkg.flytiger-eco.com && \
    ! python3 -c "from importlib.metadata import version; version('flash-attn-4')" && \
    SP=/usr/local/lib/python3.12/site-packages && \
    test -f "$SP/flash_attn_interface.py" && \
    sed -i 's/from flash_attn_3\.flash_attn_interface import/from flash_attn_interface import/g' \
        "$SP/transformer_engine/pytorch/attention/dot_product_attention/backends.py" && \
    grep -q 'from flash_attn_interface import flash_attn_func' \
        "$SP/transformer_engine/pytorch/attention/dot_product_attention/backends.py" && \
    ! grep -Fq 'from flash_attn_3.flash_attn_interface' \
        "$SP/transformer_engine/pytorch/attention/dot_product_attention/backends.py" && \
    python3 -c "import transformer_engine as te; from transformer_engine.pytorch import Linear; assert hasattr(te, 'pytorch'); print('TE pytorch OK')"

RUN printf '%s\n' \
    "image=miles-sail v0.1.0_sglang_0" \
    "megatron_commit=${MEGATRON_COMMIT} (radixark/Megatron-LM miles-main; removed base-image megatron-core 0.1.0/23.04)" \
    "miles_tag=${MILES_TAG} commit=$(git -C /root/miles rev-parse HEAD) (patch 基线 78527b910) + miles-0001(compat+sortkey)" \
    "sglang=0.5.13 in-place patched: 0001 + 0002(release+spec-worker-iter_runners)" \
    "apex=24.4.1+v0.1.0.ppu2.2.0 mbridge=git@89eb1088 flash-linear-attention=0.4.2 (standard; replaces PPU fla 1.0.0, no sail_fla) pla=1.0.0+v0.1.0.ppu2.2.0" \
    "torch_memory_saver=git@f05a8754 0.0.9.post1 (overrides PPU 0.0.9)" \
    "flash-attn-3=2.8.2+v0.2.0.ppu2.2.0" \
    "mooncake=0.3.12.post1+v0.1.0.ppu2.2.0 (native structured_object_store; replaces 0.3.9+overlay)" \
    "nvidia-modelopt=0.37.0 (+pulp,torchprofile) huggingface_hub=1.29.0 libyaml-cpp0.8" \
    > /etc/miles-release

# =====================================================================
# Final guard
# =====================================================================

RUN grep -q 'hasattr(args, "sglang_cuda_graph_backend_prefill")' /root/miles/miles/utils/arguments.py && \
    grep -q 'gpu_id = int(gpu_id)' /root/miles/miles/ray/placement_group.py && \
    grep -q 'def iter_runners' /usr/local/lib/python3.12/site-packages/sglang/srt/speculative/eagle_worker_v2.py && \
    grep -q 'def iter_runners' /usr/local/lib/python3.12/site-packages/sglang/srt/speculative/ngram_worker.py


RUN python3 - <<'PYEOF'
import importlib.metadata as md
import pathlib

import torch

# rlbase base ships torch with a PPU local-version suffix - assert the exact pinned version
assert md.version("torch") == "2.11.0+v0.2.0.ppu2.2.0", f"unexpected torch: {md.version('torch')}"

# flash-attn-4 must be absent: TE 2.16 would dispatch to its CUTE JIT frontend, broken on PPU
try:
    md.version("flash-attn-4")
    _fa4_absent = False
except md.PackageNotFoundError:
    _fa4_absent = True
assert _fa4_absent, f"flash-attn-4 still installed: {md.version('flash-attn-4')}"
_sdk_file = pathlib.Path("/usr/local/PPU_SDK/VERSION.txt")
assert _sdk_file.exists(), "PPU SDK missing: not a PPU image?"
_sdk_ver = _sdk_file.read_text().strip()

import transformer_engine as te
assert hasattr(te, "pytorch"), "te.pytorch missing (flash-attn-3 / TE fa3-import patch regression)"
from megatron.training.checkpointing import save_checkpoint  # noqa: F401
from megatron.core.models.gpt import GPTModel  # noqa: F401
from mbridge import AutoBridge  # noqa: F401
from fla.ops.gated_delta_rule import chunk_gated_delta_rule  # noqa: F401
from miles_plugins.models.qwen_gdn_backend import get_chunk_gated_delta_rule
get_chunk_gated_delta_rule("fla")
import fused_weight_gradient_mlp_cuda  # noqa: F401
import miles  # noqa: F401
import polars  # noqa: F401
import torchft  # noqa: F401
import transformers  # noqa: F401

# e2e dependency completion: mooncake structured layer / modelopt / huggingface_hub
import huggingface_hub
assert md.version("huggingface_hub") == "1.29.0", f"huggingface_hub overwritten: {md.version('huggingface_hub')}"
assert md.version("mooncake_transfer_engine").startswith("0.3.12.post1+"), (
    f"mooncake overwritten: {md.version('mooncake_transfer_engine')}"
)
from mooncake.structured_object_store import MooncakeBundleTransfer  # noqa: F401
from modelopt.torch.quantization.utils import is_quantized  # noqa: F401

# sglang patch-1/2
from sglang.srt.distributed.parallel_state import (  # noqa: F401
    ParallelismContext,
    RankParallelismConfig,
)
from sglang.srt.entrypoints.http_server import app
paths = {r.path for r in app.routes}
assert "/begin_weight_update" in paths, "patch-2: /begin_weight_update route missing"
assert "/end_weight_update" in paths, "patch-2: /end_weight_update route missing"

_tms_ver = md.version("torch_memory_saver")
assert "post1" in _tms_ver and "ppu" not in _tms_ver, f"TMS unexpected: {_tms_ver}"
from torch_memory_saver.utils import get_binary_path_from_package
import os
_tms_so = get_binary_path_from_package("torch_memory_saver_hook_mode_preload")
assert os.path.exists(_tms_so), f"TMS preload .so not found: {_tms_so}"

print(f"torch                   {md.version('torch')} (PPU SDK {_sdk_ver})")
print(f"megatron-core           {md.version('megatron-core')}")
print(f"transformer_engine      {md.version('transformer_engine')} (fa3: flash-attn-3 {md.version('flash-attn-3')})")
print(f"transformers            {transformers.__version__}")
print(f"flash-linear-attention  {md.version('flash-linear-attention')} (fla-core {md.version('fla-core')})")
print(f"mbridge                 {md.version('mbridge')}")
print(f"torch_memory_saver      {md.version('torch_memory_saver')} (preload .so: {os.path.basename(_tms_so)})")
print(f"sglang                  {md.version('sglang')} (patched in-place)")
print(f"apex                    {md.version('apex')}")
print(f"mooncake                {md.version('mooncake_transfer_engine')} (native structured_object_store)")
print(f"nvidia-modelopt         {md.version('nvidia-modelopt')} (+pulp, torchprofile)")
print(f"huggingface_hub         {md.version('huggingface_hub')}")
print("All verifications passed.")
PYEOF

RUN rm -rf /root/.cache/pip /tmp/sglang-patches
